        ],
        "responsibility": "Issue and verify narrowly scoped, tamper-evident, expiring capabilities and signed URLs with explicit replay, revocation, and storage boundaries.",
        "non_goals": [
          "Own caller authentication, application authorization policy, sessions, payload encryption, or legal non-repudiation.",
          "Own database connections, Valkey clients, HTTP servers, remote key sources, background work, or application side effects."
